# DroneWire Environment Variables
# Copy this file to .env.local and replace placeholders for local development.
# This example contains no secrets or values copied from .env.local. Secret-bearing
# fields are blank or obvious placeholders; public application defaults are noted.

# Database (Supabase PostgreSQL)
# Use the transaction pooler URL for serverless/Vercel compatibility.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true"

# AI processing — Ollama Cloud chat completions
OLLAMA_API_KEY=""
# Source defaults; override only when a different deployed model is intended.
OLLAMA_MODEL="deepseek-v4-flash"
OLLAMA_FALLBACK_MODEL="glm-5.2"

# OpenAI (embeddings only)
OPENAI_API_KEY=""

# Cron authentication
CRON_SECRET="replace-with-a-secure-random-value"

# Admin route bearer authentication
# Generate a value with: openssl rand -hex 32
ADMIN_SECRET="replace-with-a-secure-random-value"

# Exa AI Search (optional)
EXA_API_KEY=""

# SAM.gov API (optional/legacy contract integration)
SAM_GOV_API_KEY=""

# Outbound email uses the Gmail API.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# Destination for contact-form notifications; use a mailbox you control.
ADMIN_EMAIL=""
# The Gmail From identity is currently hard-coded in lib/services/email.ts.
# FROM_EMAIL is not read by the application and is intentionally omitted here.

# Canonical site URL used by metadata and outbound email links
SITE_URL="https://dronewire.org"

# Logging level: debug, info, warn, error, or silent
LOG_LEVEL="info"
