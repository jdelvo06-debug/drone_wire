// Counter-UAS Knowledge Hub Database Schema
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x", "darwin"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Article {
  id                  String   @id @default(cuid())
  title               String
  content             String?
  excerpt             String?
  sourceUrl           String?
  sourceName          String
  publishedAt         DateTime
  scrapedAt           DateTime @default(now())
  imageUrl            String?
  category            String   @default("general") // drone-warfare, counter-uas, contracts, policy
  topics              String[] @default([])
  categoryOrigin      String   @default("legacy")
  classificationLabel String   @default("unverified")
  provenanceLabel     String   @default("unverified")
  status              String   @default("published") // published, draft, archived
  views               Int      @default(0)
  readTime            Int? // estimated read time in minutes

  // AI processing
  aiRetryCount     Int       @default(0)
  aiProcessedAt    DateTime?
  aiLastAttemptAt  DateTime?
  aiNextRetryAt    DateTime?
  aiFailureCode    String?
  aiQuarantinedAt  DateTime?
  aiProcessingStartedAt DateTime?
  generatedContent Boolean   @default(false)

  // Editorial quality and event deduplication
  eventClusterId          String?
  isClusterRepresentative Boolean @default(true)
  relevanceScore          Float?
  exclusionReason         String?

  // AI-generated content
  aiSummary    String?
  whyItMatters String?
  keyPoints    String[] // Array of key takeaways
  confidence   Float? // AI confidence score 0-1
  embedding    Unsupported("vector(1536)")? // pgvector embedding for similarity search
  alertSent    Boolean                      @default(false) // Whether alert was sent for this article

  // Relations
  tags            ArticleTag[]
  relatedArticles ArticleRelation[] @relation("MainArticle")
  relatedFrom     ArticleRelation[] @relation("RelatedArticle")
  eventCluster    EventCluster?     @relation(fields: [eventClusterId], references: [id], onDelete: SetNull)
  mediaAssets     MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([publishedAt])
  @@index([sourceName])
  @@index([eventClusterId, isClusterRepresentative])
  @@index([relevanceScore])
  @@index([aiNextRetryAt, aiQuarantinedAt])
  @@index([aiProcessingStartedAt])
  @@map("articles")
}

model EventCluster {
  id                      String    @id @default(cuid())
  fingerprint             String    @unique
  representativeArticleId String?
  articles                Article[]
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([representativeArticleId])
  @@map("event_clusters")
}

model Tag {
  id       String @id @default(cuid())
  name     String @unique
  slug     String @unique
  category String @default("general") // technology, company, country, system-type
  color    String @default("#3B82F6") // Hex color for UI

  articles   ArticleTag[]
  explainers ExplainerTag[]
  systems    SystemTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("tags")
}

model ArticleTag {
  id        String @id @default(cuid())
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([articleId, tagId])
  @@map("article_tags")
}

model ArticleRelation {
  id               String @id @default(cuid())
  mainArticleId    String
  relatedArticleId String
  relationshipType String @default("related") // related, follow-up, background

  mainArticle    Article @relation("MainArticle", fields: [mainArticleId], references: [id], onDelete: Cascade)
  relatedArticle Article @relation("RelatedArticle", fields: [relatedArticleId], references: [id], onDelete: Cascade)

  @@unique([mainArticleId, relatedArticleId])
  @@map("article_relations")
}

model Explainer {
  id              String  @id @default(cuid())
  title           String
  slug            String  @unique
  description     String
  content         String // Rich content with sections
  imageUrl        String?
  category        String // systems, threats, countermeasures, policy
  difficulty      String  @default("beginner") // beginner, intermediate, advanced
  readTime        Int     @default(5) // estimated minutes
  views           Int     @default(0)
  featured        Boolean @default(false)
  provenanceLabel String  @default("unverified")

  // Structured content fields
  whatItIs       String?
  howItWorks     String?
  keyFeatures    String[]
  advantages     String[]
  disadvantages  String[]
  realWorldUse   String?
  relatedSystems String[]

  tags        ExplainerTag[]
  citations   ExplainerCitation[]
  mediaAssets MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@map("explainers")
}

model ExplainerTag {
  id          String @id @default(cuid())
  explainerId String
  tagId       String

  explainer Explainer @relation(fields: [explainerId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([explainerId, tagId])
  @@map("explainer_tags")
}

model Contract {
  id             String   @id @default(cuid())
  contractNumber String?  @unique
  title          String
  description    String?
  awardDate      DateTime
  company        String
  contractorType String   @default("prime") // prime, subcontractor
  value          Decimal  @db.Decimal(12, 2)
  currency       String   @default("USD")
  duration       Int? // months
  status         String   @default("active") // reported status, or Not reported
  category       String // counter-uas, surveillance, research, training

  // Government details
  agency   String // DOD, DHS, etc.
  office   String? // specific office/division
  location String? // primary performance location

  // Additional details
  keyPersonnel   String[] // Key personnel if available
  relatedSystems String[] // Related systems/technologies

  sourceUrl String?
  scrapedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([awardDate])
  @@index([company])
  @@index([category])
  @@index([agency])
  @@map("contracts")
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  firstName        String?
  lastName         String?
  company          String?
  jobTitle         String?
  interests        String[] // Array of interest categories
  subscriptionDate DateTime @default(now())
  status           String   @default("active") // active, unsubscribed, bounced
  source           String   @default("website") // website, referral, etc.

  // Alert preferences
  alertsEnabled             Boolean   @default(true) // Legacy compatibility; preserved until a separately approved consent migration
  weeklyDigestEnabled       Boolean   @default(false)
  breakingAlertsEnabled     Boolean   @default(false)
  breakingAlertsConsentedAt DateTime?
  preferenceTokenRevision   Int       @default(0)
  alertCategories           String[] // Categories to receive alerts for (empty = all)
  alertFrequency            String    @default("instant") // instant, daily, weekly
  minConfidence             Float     @default(0.8) // Minimum AI confidence for alerts
  lastAlertSent             DateTime?

  // Engagement tracking
  lastEmailSent   DateTime?
  lastEmailOpened DateTime?
  emailsReceived  Int       @default(0)
  emailsOpened    Int       @default(0)
  alertsReceived  Int       @default(0)

  deliveries NewsletterDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([subscriptionDate])
  @@index([alertsEnabled])
  @@map("newsletter_subscribers")
}

model RssFeed {
  id          String    @id @default(cuid())
  name        String
  url         String    @unique
  category    String // defense-news, contracts, industry
  isActive    Boolean   @default(true)
  lastChecked DateTime?
  lastSuccess DateTime?
  errorCount  Int       @default(0)

  // Feed metadata
  description String?
  language    String  @default("en")
  updateFreq  String? // daily, weekly, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([lastChecked])
  @@map("rss_feeds")
}

model ContactSubmission {
  id      String  @id @default(cuid())
  name    String
  email   String
  company String?
  subject String
  message String
  type    String  @default("general") // general, press, partnership, tip
  status  String  @default("new") // new, reviewing, responded, closed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
}

model RequestRateLimit {
  id          String   @id @default(cuid())
  route       String
  keyHash     String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([route, keyHash, windowStart])
  @@index([expiresAt])
  @@map("request_rate_limits")
}

// Counter-UAS Systems Database
model System {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  description     String
  content         String // Rich markdown content for detailed information
  imageUrl        String?
  provenanceLabel String  @default("unverified")

  // Classification
  category    String // c2, sensor, effector, integrated
  subcategory String? // More granular classification

  // Manufacturer/Origin
  manufacturer String
  country      String // Country of origin

  // Technical Details
  primaryCapability String // Brief description of main capability
  specifications    String[] // Array of key technical specs
  detectionRange    String? // For sensors
  effectiveRange    String? // For effectors
  platforms         String[] // Compatible platforms (ground, naval, air, fixed)

  // Status and Metadata
  status        String   @default("operational") // operational, contracted, development, prototype, retired
  inServiceDate String? // Year or date entered service
  deployedBy    String[] // Countries/forces using the system

  // Structured content (following Explainer pattern)
  whatItIs      String?
  howItWorks    String?
  keyFeatures   String[]
  advantages    String[]
  disadvantages String[]
  combatRecord  String? // Real-world usage/effectiveness

  // Procurement & Technical Intelligence
  trl                 Int? // Technology Readiness Level 1-9
  trlLabel            String? // e.g. "Production (TRL 9)", "LRIP (TRL 7-8)"
  estimatedPriceRange String? // e.g. "$60K–$80K/unit"
  procurementStatus   String? // e.g. "DoD contract; JIDO recommended; 2,500+ deployed"
  ndaaCompliant       Boolean? // Section 889 NDAA compliance (null = unknown)
  targetSet           String? // e.g. "Group 1-2", "Group 1-3"
  defeatMechanism     String? // e.g. "EW (Jam + GNSS Spoof)", "Kinetic (Net capture)"
  unitWeightKg        Float? // Unit weight in kg
  jiatf401Approved    Boolean? // DoD Joint Counter-UAS Office approved

  // Relations
  relatedSystems String[]
  tags           SystemTag[]
  citations      SystemCitation[]
  mediaAssets    MediaAsset[]

  // Tracking
  views    Int     @default(0)
  featured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([country])
  @@index([manufacturer])
  @@index([featured])
  @@map("systems")
}

model ContentSource {
  id               String    @id @default(cuid())
  canonicalUrl     String    @unique
  title            String
  publisher        String
  sourceType       String
  publicationDate  DateTime?
  accessedAt       DateTime  @default(now())
  license          String?
  archiveUrl       String?
  linkHealthStatus String    @default("unchecked")
  lastCheckedAt    DateTime?

  systemCitations    SystemCitation[]
  explainerCitations ExplainerCitation[]
  mediaAssets        MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publisher])
  @@index([sourceType])
  @@index([linkHealthStatus])
  @@map("content_sources")
}

model SystemCitation {
  id              String    @id @default(cuid())
  systemId        String
  sourceId        String
  claimKey        String
  evidenceText    String?
  stance          String    @default("supports")
  provenanceLabel String
  lastCheckedAt   DateTime?

  system System        @relation(fields: [systemId], references: [id], onDelete: Cascade)
  source ContentSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([systemId, sourceId, claimKey])
  @@index([systemId, claimKey])
  @@index([sourceId])
  @@map("system_citations")
}

model ExplainerCitation {
  id              String    @id @default(cuid())
  explainerId     String
  sourceId        String
  claimKey        String
  evidenceText    String?
  stance          String    @default("supports")
  provenanceLabel String
  lastCheckedAt   DateTime?

  explainer Explainer     @relation(fields: [explainerId], references: [id], onDelete: Cascade)
  source    ContentSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([explainerId, sourceId, claimKey])
  @@index([explainerId, claimKey])
  @@index([sourceId])
  @@map("explainer_citations")
}

model MediaAsset {
  id                String    @id @default(cuid())
  controlledUrl     String?
  remoteUrl         String?
  origin            String
  attribution       String
  license           String
  depictedEntity    String
  depictedVariant   String?
  checksum          String?
  storageMode       String
  verificationState String    @default("unverified")
  mimeType          String?
  width             Int?
  height            Int?
  lastCheckedAt     DateTime?
  sourceId          String?
  articleId         String?
  systemId          String?
  explainerId       String?

  source    ContentSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  article   Article?       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  system    System?        @relation(fields: [systemId], references: [id], onDelete: Cascade)
  explainer Explainer?     @relation(fields: [explainerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([systemId])
  @@index([explainerId])
  @@index([articleId])
  @@index([verificationState])
  @@map("media_assets")
}

model SearchDocument {
  id              String                       @id @default(cuid())
  entityType      String
  entityId        String
  title           String
  href            String
  aliases         String[]                     @default([])
  category        String?
  imageUrl        String?
  facets          Json
  searchableText  String
  provenanceLabel String                       @default("unverified")
  embedding       Unsupported("vector(1536)")?
  sourceUpdatedAt DateTime
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([category])
  @@index([provenanceLabel])
  @@map("search_documents")
}

model NewsletterIssue {
  id              String    @id @default(cuid())
  weekKey         String    @unique
  coverageStart   DateTime
  coverageEnd     DateTime
  selectedContent Json
  renderedPreview String
  status          String    @default("preview")
  eligibleCount   Int       @default(0)
  deliveredCount  Int       @default(0)
  failedCount     Int       @default(0)
  failureSummary  String?
  generatedAt     DateTime  @default(now())
  sendStartedAt   DateTime?
  completedAt     DateTime?

  deliveries NewsletterDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([coverageStart, coverageEnd])
  @@map("newsletter_issues")
}

model NewsletterDelivery {
  id                String    @id @default(cuid())
  issueId           String
  subscriberId      String
  providerMessageId String?
  attemptCount      Int       @default(0)
  status            String    @default("pending")
  errorCode         String?
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?

  issue      NewsletterIssue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issueId, subscriberId])
  @@index([status, lastAttemptAt])
  @@index([subscriberId])
  @@map("newsletter_deliveries")
}

model SystemTag {
  id       String @id @default(cuid())
  systemId String
  tagId    String

  system System @relation(fields: [systemId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([systemId, tagId])
  @@map("system_tags")
}
